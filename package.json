{
	"name": "n8n-nodes-encrypted-zip",
	"version": "0.0.0-development",
	"description": "Extract password-protected ZIP archives (WinZip AES and ZipCrypto) in memory, with the password held in an n8n credential.",
	"license": "MIT",
	"homepage": "https://github.com/calvertjadon/n8n-nodes-encrypted-zip#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"zip",
		"aes",
		"zipcrypto",
		"encryption",
		"decompression"
	],
	"author": {
		"name": "Jadon Calvert",
		"email": "calvertjadon@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/calvertjadon/n8n-nodes-encrypted-zip.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:ci": "eslint . --rule '{\"@n8n/community-nodes/no-runtime-dependencies\": \"off\"}'",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"smoke": "bash test/smoke/run.sh",
		"commitlint": "commitlint",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ZipPasswordApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/EncryptedZip/EncryptedZip.node.js"
		]
	},
	"engines": {
		"node": ">=22.22.0"
	},
	"publishConfig": {
		"provenance": true
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"@zip.js/zip.js": "2.25.0"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@n8n/node-cli": "0.49.1",
		"@release-it/conventional-changelog": "12.0.2",
		"@types/node": "24.13.6",
		"@zip.js/zip.js": "2.25.0",
		"conventional-commits-parser": "7.1.2",
		"conventional-recommended-bump": "12.1.0",
		"eslint": "9.39.5",
		"n8n-workflow": "2.39.3",
		"prettier": "3.9.9",
		"release-it": "21.1.0",
		"typescript": "5.9.3",
		"vitest": "5.0.2"
	}
}
